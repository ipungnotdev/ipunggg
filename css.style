*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#090014;
color:white;
}

nav{
display:flex;
justify-content:space-between;
align-items:center;
padding:18px;
background:#120020;
position:sticky;
top:0;
z-index:999;
}

.nav-left{
display:flex;
align-items:center;
gap:10px;
}

.logo{
font-size:22px;
font-weight:bold;
}

.logo-img{
width:38px;
height:38px;
border-radius:50%;
object-fit:cover;
box-shadow:0 0 15px #8b5cf6;
}

.hamburger{
font-size:28px;
cursor:pointer;
}

.mobile-menu{
display:none;
position:absolute;
top:70px;
right:15px;
width:240px;
background:#170028;
border:1px solid #8b5cf6;
border-radius:20px;
overflow:hidden;
box-shadow:0 0 20px rgba(168,85,247,.6);
}

.mobile-menu a{
display:block;
padding:15px;
color:white;
text-decoration:none;
border-bottom:1px solid rgba(255,255,255,.1);
}

.banner img{
width:100%;
height:220px;
object-fit:cover;
}

.category{
display:flex;
gap:10px;
padding:14px;
overflow:auto;
}

.category button,
.btn{
flex:1;
padding:12px;
border:none;
border-radius:14px;
background:#7c3aed;
color:white;
font-weight:bold;
cursor:pointer;
}

.products{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:14px;
padding:14px;
}

.card{
background:#160025;
border-radius:24px;
overflow:hidden;
border:1px solid #8b5cf6;
box-shadow:0 0 18px rgba(168,85,247,.5);
}

.card img{
width:100%;
height:130px;
object-fit:cover;
}

.card-content{
padding:12px;
}

.price{
margin:10px 0;
opacity:.8;
}

.overlay{
display:none;
position:fixed;
inset:0;
background:rgba(0,0,0,.9);
z-index:99999;
justify-content:center;
align-items:center;
padding:20px;
}

.popup,
.box{
width:100%;
max-width:400px;
background:#150025;
border:1px solid #8b5cf6;
padding:22px;
border-radius:24px;
margin:auto;
margin-top:20px;
}

.popup input,
.box input,
.box select{
width:100%;
padding:13px;
margin-bottom:12px;
border:none;
border-radius:12px;
background:#25003d;
color:white;
}

.qris{
width:220px;
display:block;
margin:auto;
border-radius:20px;
margin-top:14px;
}

.upload-box{
display:flex;
align-items:center;
justify-content:center;
height:120px;
border:2px dashed #8b5cf6;
border-radius:20px;
margin-top:15px;
cursor:pointer;
background:#220033;
flex-direction:column;
gap:10px;
}

.upload-icon{
font-size:40px;
}

.upload-text{
text-align:center;
margin-top:12px;
margin-bottom:10px;
opacity:.8;
}

.title{
font-size:28px;
font-weight:bold;
padding:20px;
}

.preview{
width:100%;
height:180px;
object-fit:cover;
border-radius:20px;
margin-top:10px;
border:1px solid #8b5cf6;
}
